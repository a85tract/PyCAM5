[ccpp-table-properties]
  name = dadadj
  type = scheme

[ccpp-arg-table]
  name  = dadadj_run
  type  = scheme
[ lchnk ]
  standard_name = physics_chunk_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pcols ]
  standard_name = horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pverp ]
  standard_name = vertical_interface_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = in
[ pint ]
  standard_name = air_pressure_at_interface
  units = Pa
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_interface_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = in
[ t ]
  standard_name = air_temperature
  units = K
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = inout
[ q ]
  standard_name = water_vapor_specific_humidity
  units = kg kg-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = inout
[ cappa ]
  standard_name = ratio_of_dry_air_gas_constant_to_specific_heat
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ nlvdry ]
  standard_name = dry_adjustment_bottom_level
  units = index
  type = integer
  dimensions = ()
  intent = in
[ lat ]
  standard_name = latitude_for_diagnostics
  units = degrees_north
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = in
[ lon ]
  standard_name = longitude_for_diagnostics
  units = degrees_east
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = in
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_flag
  units = 1
  type = integer
  dimensions = ()
  intent = out
