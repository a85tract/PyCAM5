  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ qsthat ]
  standard_name = deep_convective_interface_saturation_mixing_ratio
  units = kg kg-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ hmn ]
  standard_name = environmental_moist_static_energy_for_deep_convection
  units = J kg-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ hsat ]
  standard_name = environmental_saturated_moist_static_energy_for_deep_convection
  units = J kg-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ hsthat ]
  standard_name = interface_saturated_moist_static_energy_for_deep_convection
  units = J kg-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ wteu ]
  standard_name = water_tracer_updraft_entrainment_before_unit_conversion
  units = m-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ wted ]
  standard_name = water_tracer_downdraft_entrainment_before_unit_conversion
  units = m-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ wtdu ]
  standard_name = water_tracer_updraft_detrainment_before_unit_conversion
  units = m-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ wtmu ]
  standard_name = water_tracer_updraft_mass_flux_before_unit_conversion
  units = 1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ wtmd ]
  standard_name = water_tracer_downdraft_mass_flux_before_unit_conversion
  units = 1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ wtcu ]
  standard_name = water_tracer_condensation_rate_before_unit_conversion
  units = m-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ c0mask ]
  standard_name = deep_convective_autoconversion_coefficient
  units = m-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = out
[ wtrpd ]
  standard_name = water_tracer_rain_production_rate_before_unit_conversion
  units = m-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ qds ]
  standard_name = deep_convective_downdraft_saturation_mixing_ratio
  units = kg kg-1
