[ccpp-table-properties]
  name = energy_change
  type = scheme

[ccpp-arg-table]
  name = energy_change_run
  type = scheme
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = r8
  dimensions = ()
  intent = in
[ dt ]
  standard_name = physics_timestep
  units = s
  type = real | kind = r8
  dimensions = ()
  intent = in
[ p ]
  standard_name = vertical_pressure_coordinates_for_gravity_wave_drag
  units = Pa
  type = coords1d
  dimensions = ()
  intent = in
[ u ]
  standard_name = eastward_wind
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ v ]
  standard_name = northward_wind
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dudt ]
  standard_name = tendency_of_eastward_wind
  units = m s-2
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dvdt ]
  standard_name = tendency_of_northward_wind
  units = m s-2
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ dsdt ]
  standard_name = tendency_of_dry_static_energy
  units = J kg-1 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ de ]
  standard_name = column_energy_change_due_to_gravity_wave_drag
  units = W m-2
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = out
