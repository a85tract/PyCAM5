[ccpp-table-properties]
  name = gw_oro_src
  type = scheme

[ccpp-arg-table]
  name = gw_oro_src_run
  type = scheme
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pverp ]
  standard_name = vertical_interface_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ rair ]
  standard_name = dry_air_gas_constant
  units = J kg-1 K-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ ngwv ]
  standard_name = gravity_wave_spectrum_half_width
  units = count
  type = integer
  dimensions = ()
  intent = in
[ nwave ]
  standard_name = gravity_wave_spectrum_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ fcrit2 ]
  standard_name = squared_critical_froude_number_for_orographic_gravity_wave_drag
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ kwv ]
  standard_name = horizontal_wave_number_for_orographic_gravity_wave_drag
  units = m-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ p ]
  standard_name = vertical_pressure_coordinates_for_gravity_wave_drag
  units = Pa
  type = coords1d
  dimensions = ()
  intent = in
[ u ]
  standard_name = eastward_wind
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ v ]
  standard_name = northward_wind
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ t ]
  standard_name = air_temperature
  units = K
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ sgh ]
  standard_name = standard_deviation_of_orography
  units = m
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = in
[ zm ]
  standard_name = geopotential_height_wrt_surface
  units = m
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ nm ]
  standard_name = brunt_vaisalla_frequencies
  units = s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ src_level ]
  standard_name = vertical_index_of_gravity_wave_source_level
  units = index
  type = integer
  dimensions = (horizontal_loop_extent)
  intent = out
[ tend_level ]
  standard_name = vertical_index_of_lowest_gravity_wave_tendency_level
  units = index
  type = integer
  dimensions = (horizontal_loop_extent)
  intent = out
[ tau ]
  standard_name = wave_reynolds_stress_for_orographic_gravity_wave_drag
  units = N m-2
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, gravity_wave_spectrum_dimension, vertical_interface_dimension)
  intent = out
[ ubm ]
  standard_name = wind_speed_along_gravity_wave_source_direction
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ ubi ]
  standard_name = wind_speed_along_gravity_wave_source_direction_at_interfaces
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_interface_dimension)
  intent = out
[ xv ]
  standard_name = eastward_component_of_gravity_wave_source_wind_unit_vector
  units = 1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = out
[ yv ]
  standard_name = northward_component_of_gravity_wave_source_wind_unit_vector
  units = 1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = out
[ c ]
  standard_name = phase_speeds_for_orographic_gravity_wave_drag
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, gravity_wave_spectrum_dimension)
  intent = out
