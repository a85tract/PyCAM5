[ccpp-table-properties]
  name = gas_phase_chemdr
  type = scheme

[ccpp-arg-table]
  name  = gas_phase_chemdr_run
  type  = scheme
[ phase ]
  standard_name = gas_phase_chemistry_solver_phase
  units = index
  type = integer
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ gas_pcnst ]
  standard_name = gas_phase_chemical_species_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ rxntot ]
  standard_name = chemical_reaction_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ extcnt ]
  standard_name = external_forcing_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ clscnt1 ]
  standard_name = explicit_chemical_species_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ clscnt4 ]
  standard_name = implicit_chemical_species_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ nzcnt ]
  standard_name = implicit_solver_jacobian_entry_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ itermax ]
  standard_name = chemistry_solver_iteration_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ o3_index ]
  standard_name = ozone_species_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ o3s_index ]
  standard_name = stratospheric_ozone_species_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ h2so4_index ]
  standard_name = sulfuric_acid_species_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ timestep ]
  standard_name = physics_timestep
  units = s
  type = real | kind = r8
  dimensions = ()
  intent = in
[ total_density ]
  standard_name = air_number_density
  units = molecule cm-3
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = in
[ ltrop ]
  standard_name = chemistry_tropopause_level_index
  units = index
  type = integer
  dimensions = (horizontal_loop_extent)
  intent = in
[ clsmap4 ]
  standard_name = implicit_species_to_mechanism_index
  units = index
  type = integer
  dimensions = (implicit_chemical_species_dimension)
  intent = in
[ permute4 ]
  standard_name = implicit_species_permutation_index
  units = index
  type = integer
  dimensions = (implicit_chemical_species_dimension)
  intent = in
[ class_independent_reaction_count ]
  standard_name = class_independent_reaction_count
  units = count
  type = integer
  dimensions = ()
  intent = in
[ epsilon ]
  standard_name = implicit_solver_relative_tolerance
  units = 1
  type = real | kind = r8
  dimensions = (implicit_chemical_species_dimension)
  intent = in
[ factor ]
  standard_name = implicit_solver_refactorization_mask
  units = flag
  type = logical
  dimensions = (chemistry_solver_iteration_dimension)
  intent = in
[ small ]
  standard_name = implicit_solver_small_value
  units = mol mol-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ reaction_rates ]
  standard_name = chemical_reaction_rate
  units = 1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension,chemical_reaction_dimension)
  intent = in
[ het_rates ]
  standard_name = heterogeneous_chemical_loss_rate
  units = s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension,gas_phase_chemical_species_dimension)
  intent = in
[ extfrc ]
  standard_name = chemical_external_forcing
  units = mol mol-1 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension,external_forcing_dimension)
  intent = in
[ vmr ]
  standard_name = gas_phase_species_mole_fraction
  units = mol mol-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension,gas_phase_chemical_species_dimension)
  intent = inout
[ o3s_loss ]
  standard_name = stratospheric_ozone_loss_rate
  units = s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = out
[ del_h2so4_gasprod ]
  standard_name = sulfuric_acid_gas_production_increment
  units = mol mol-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension)
  intent = inout
[ prod_out ]
  standard_name = implicit_chemistry_species_production_rate
  units = mol mol-1 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension,implicit_chemical_species_dimension)
  intent = out
[ loss_out ]
  standard_name = implicit_chemistry_species_loss_rate
  units = mol mol-1 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent,vertical_layer_dimension,implicit_chemical_species_dimension)
  intent = out
[ explicit_entry_count ]
  standard_name = explicit_solver_entry_count
  units = count
  type = integer
  dimensions = ()
  intent = inout
[ implicit_entry_count ]
  standard_name = implicit_solver_entry_count
  units = count
  type = integer
  dimensions = ()
  intent = inout
[ solver_failure_count ]
  standard_name = implicit_solver_failure_count
  units = count
  type = integer
  dimensions = ()
  intent = out
[ last_failure_dt ]
  standard_name = implicit_solver_last_failure_timestep
  units = s
  type = real | kind = r8
  dimensions = ()
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_flag
  units = 1
  type = integer
  dimensions = ()
  intent = out
