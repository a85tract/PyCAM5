[ccpp-table-properties]
  name = exp_sol
  type = scheme

[ccpp-arg-table]
  name = exp_sol_run
  type = scheme
[ explicit_species_count ]
  standard_name = number_of_explicit_chemistry_species
  units = count
  type = integer
  dimensions = ()
  intent = in
[ entry_count ]
  standard_name = explicit_chemistry_solver_entry_count
  units = count
  type = integer
  dimensions = ()
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
