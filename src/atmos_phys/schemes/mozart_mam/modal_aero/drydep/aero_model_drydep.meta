  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, number_of_constituents)
  intent = out
[ dep_trb_is ]
  standard_name = interstitial_aerosol_turbulent_dry_deposition_flux
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, number_of_constituents)
  intent = out
[ dep_grv_is ]
  standard_name = interstitial_aerosol_gravitational_dry_deposition_flux
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, number_of_constituents)
  intent = out
[ dep_flux_cw ]
  standard_name = cloudborne_aerosol_total_dry_deposition_flux
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, number_of_constituents)
  intent = out
[ dep_trb_cw ]
  standard_name = cloudborne_aerosol_turbulent_dry_deposition_flux
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, number_of_constituents)
  intent = out
[ dep_grv_cw ]
  standard_name = cloudborne_aerosol_gravitational_dry_deposition_flux
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, number_of_constituents)
  intent = out
[ aerdepdryis ]
  standard_name = interstitial_aerosol_surface_dry_deposition_flux
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, number_of_constituents)
  intent = out
[ aerdepdrycw ]
  standard_name = cloudborne_aerosol_surface_dry_deposition_flux
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, number_of_constituents)
  intent = out
[ active_is ]
  standard_name = flag_for_active_interstitial_aerosol_dry_deposition
  units = 1
  type = logical
  dimensions = (number_of_constituents)
  intent = out
[ active_cw ]
  standard_name = flag_for_active_cloudborne_aerosol_dry_deposition
  units = 1
  type = logical
  dimensions = (number_of_constituents)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = flag
  type = integer
  dimensions = ()
  intent = out
