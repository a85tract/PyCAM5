  units = kg m-3
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, aerosol_mode_dimension)
  intent = in
[ qsrflx_out ]
  standard_name = modal_aerosol_coagulation_column_tendency_unscaled
  units = mol Pa s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, physics_constituent_dimension)
  intent = out
[ dotend_out ]
  standard_name = modal_aerosol_coagulation_tendency_flags
  units = flag
  type = logical
  dimensions = (physics_constituent_dimension)
  intent = out
[ ierr_out ]
  standard_name = modal_aerosol_coagulation_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
