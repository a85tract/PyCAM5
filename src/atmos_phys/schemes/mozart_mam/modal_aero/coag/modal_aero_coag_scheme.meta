  standard_name = primary_carbon_aging_sulfate_monolayer_count
  units = count
  type = real | kind = r8
  dimensions = ()
  intent = in
[ soa_equivso4_factor_in ]
  standard_name = secondary_organic_to_equivalent_sulfate_factor
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ tmelt_in ]
  standard_name = water_melting_temperature
  units = K
  type = real | kind = r8
  dimensions = ()
  intent = in
[ t ]
  standard_name = air_temperature
  units = K
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ q ]
  standard_name = gas_phase_species_mole_fraction
  units = mol mol-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, gas_phase_chemical_species_dimension)
  intent = inout
[ dgncur_a ]
  standard_name = dry_geometric_mean_aerosol_diameter
  units = m
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, aerosol_mode_dimension)
  intent = in
[ dgncur_awet ]
  standard_name = wet_geometric_mean_aerosol_diameter
  units = m
  type = real | kind = r8
