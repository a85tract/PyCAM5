[ccpp-table-properties]
  name = drydep_update
  type = scheme

[ccpp-arg-table]
  name = drydep_update_run
  type = scheme
[ number_drydep_species ]
  standard_name = number_of_dry_deposition_species
  units = count
  type = integer
  dimensions = ()
  intent = in
[ drydep_method ]
  standard_name = dry_deposition_method_name
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ land_drydep_method ]
  standard_name = land_model_dry_deposition_method_name
  units = none
  type = character | kind = len=*
  dimensions = ()
  intent = in
[ do_update ]
  standard_name = update_land_dry_deposition_velocity_pointer
  units = flag
  type = logical
  dimensions = ()
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
