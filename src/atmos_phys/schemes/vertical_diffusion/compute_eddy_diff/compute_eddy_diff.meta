  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = inout
[ tauresy ]
  standard_name = residual_northward_surface_stress
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = inout
[ ksrftms ]
