[ccpp-table-properties]
  name = compute_eddy_diff
  type = scheme

[ccpp-arg-table]
  name = compute_eddy_diff_run
  type = scheme
[ lchnk ]
  standard_name = physics_chunk_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ pcols ]
  standard_name = allocated_horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pverp ]
  standard_name = vertical_interface_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ t ]
  standard_name = air_temperature_for_eddy_diffusion
  units = K
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ qv ]
