[ccpp-table-properties]
  name = compute_tms
  type = scheme

[ccpp-arg-table]
  name = compute_tms_run
  type = scheme
[ pcols ]
  standard_name = allocated_horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ orocnst ]
  standard_name = subgrid_orographic_standard_deviation_to_height_factor
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ z0fac ]
  standard_name = orographic_roughness_length_factor
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ karman ]
  standard_name = von_karman_constant
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = r8
  dimensions = ()
  intent = in
[ rair ]
  standard_name = gas_constant_of_dry_air
  units = J kg-1 K-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ u ]
  standard_name = eastward_wind
  units = m s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ v ]
  standard_name = northward_wind
  units = m s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ t ]
  standard_name = air_temperature
  units = K
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ pmid ]
  standard_name = air_pressure
  units = Pa
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ exner ]
  standard_name = inverse_exner_function
  units = 1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ zm ]
  standard_name = geopotential_height
  units = m
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ sgh ]
  standard_name = subgrid_orographic_standard_deviation
  units = m
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = in
[ landfrac ]
  standard_name = land_area_fraction
  units = 1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = in
[ ksrf ]
  standard_name = turbulent_mountain_surface_drag_coefficient
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = out
[ taux ]
  standard_name = eastward_turbulent_mountain_surface_stress
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = out
[ tauy ]
  standard_name = northward_turbulent_mountain_surface_stress
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
