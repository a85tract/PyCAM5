[ccpp-table-properties]
  name = compute_vdiff
  type = scheme

[ccpp-arg-table]
  name = compute_vdiff_run
  type = scheme
[ lchnk ]
  standard_name = physics_chunk_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ pcols ]
  standard_name = allocated_horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pverp ]
  standard_name = vertical_interface_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ ncnst ]
  standard_name = constituent_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pmid ]
  standard_name = air_pressure_for_vertical_diffusion
  units = Pa
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ pint ]
  standard_name = air_pressure_at_interface_for_vertical_diffusion
  units = Pa
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness_for_vertical_diffusion
  units = Pa
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ rpdel ]
  standard_name = inverse_air_pressure_thickness_for_vertical_diffusion
  units = Pa-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ t ]
  standard_name = air_temperature_for_vertical_diffusion
  units = K
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ ztodt ]
  standard_name = vertical_diffusion_timestep
  units = s
  type = real | kind = r8
  dimensions = ()
  intent = in
[ taux ]
  standard_name = eastward_stress_at_surface_for_vertical_diffusion
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = in
[ tauy ]
  standard_name = northward_stress_at_surface_for_vertical_diffusion
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = in
[ shflx ]
  standard_name = sensible_heat_flux_at_surface_for_vertical_diffusion
  units = W m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = in
[ cflx ]
  standard_name = constituent_flux_at_surface_for_vertical_diffusion
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, constituent_dimension)
  intent = in
[ ntop ]
  standard_name = top_vertical_diffusion_interface_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ nbot ]
  standard_name = bottom_vertical_diffusion_interface_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ kvh ]
  standard_name = eddy_diffusivity_for_heat
  units = m2 s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = in
[ kvm ]
  standard_name = eddy_diffusivity_for_momentum
  units = m2 s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = inout
[ kvq ]
  standard_name = eddy_diffusivity_for_constituents
  units = m2 s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = inout
[ cgs ]
  standard_name = countergradient_star_for_vertical_diffusion
  units = 1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = inout
[ cgh ]
  standard_name = countergradient_heat_term_for_vertical_diffusion
  units = J kg-1 m-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = inout
[ zi ]
  standard_name = geopotential_height_at_interface_for_vertical_diffusion
  units = m
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = in
[ ksrftms ]
  standard_name = turbulent_mountain_surface_drag_coefficient
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = in
[ qmincg ]
  standard_name = minimum_constituent_mixing_ratio_for_countergradient_transport
  units = kg kg-1
  type = real | kind = r8
  dimensions = (constituent_dimension)
  intent = in
[ fieldlist ]
  standard_name = vertical_diffusion_field_selector
  units = none
  type = vdiff_selector
  dimensions = ()
  intent = in
[ fieldlistm ]
  standard_name = molecular_diffusion_field_selector
  units = none
  type = vdiff_selector
  dimensions = ()
  intent = in
[ u ]
  standard_name = eastward_wind_after_vertical_diffusion
  units = m s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = inout
[ v ]
  standard_name = northward_wind_after_vertical_diffusion
  units = m s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = inout
[ q ]
  standard_name = constituent_mixing_ratio_after_vertical_diffusion
  units = kg kg-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension, constituent_dimension)
  intent = inout
[ dse ]
  standard_name = dry_static_energy_after_vertical_diffusion
  units = J kg-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = inout
[ tautmsx ]
  standard_name = implicit_eastward_turbulent_mountain_surface_stress
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = out
[ tautmsy ]
  standard_name = implicit_northward_turbulent_mountain_surface_stress
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = out
[ dtk ]
  standard_name = temperature_tendency_from_vertical_diffusion_kinetic_energy_dissipation
  units = K s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = out
[ topflx ]
  standard_name = molecular_heat_flux_at_top_interface
  units = W m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = out
[ tauresx ]
  standard_name = residual_eastward_surface_stress
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = inout
[ tauresy ]
  standard_name = residual_northward_surface_stress
  units = N m-2
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension)
  intent = inout
[ itaures ]
  standard_name = update_residual_surface_stress_flag
  units = flag
  type = integer
  dimensions = ()
  intent = in
[ cpairv ]
  standard_name = composition_dependent_specific_heat_of_dry_air_at_constant_pressure
  units = J kg-1 K-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_layer_dimension)
  intent = in
[ rairi ]
  standard_name = gas_constant_of_dry_air_at_interfaces_for_vertical_diffusion
  units = J kg-1 K-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = in
[ do_molec_diff ]
  standard_name = do_molecular_diffusion
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ kvt ]
  standard_name = kinematic_molecular_conductivity
  units = m2 s-1
  type = real | kind = r8
  dimensions = (allocated_horizontal_dimension, vertical_interface_dimension)
  intent = out
  optional = True
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
