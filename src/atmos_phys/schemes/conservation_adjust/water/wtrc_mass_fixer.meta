[ccpp-table-properties]
  name = wtrc_mass_fixer
  type = scheme

[ccpp-arg-table]
  name = wtrc_mass_fixer_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pwtype ]
  standard_name = number_of_water_types
  units = count
  type = integer
  dimensions = ()
  intent = in
[ nwset ]
  standard_name = number_of_water_tracer_sets
  units = count
  type = integer
  dimensions = ()
  intent = in
[ isphdo ]
  standard_name = hdo_species_index
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ wisotope ]
  standard_name = flag_for_water_isotopes
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ iatype ]
  standard_name = constituent_index_by_water_set_and_type
  units = 1
  type = integer
  dimensions = (water_tracer_set_storage_dimension, number_of_water_types)
  intent = in
[ bulk_indices ]
  standard_name = bulk_water_constituent_indices
  units = 1
  type = integer
  dimensions = (number_of_water_types)
  intent = in
[ rstd_by_wset ]
  standard_name = standard_ratio_by_water_set_and_type
  units = 1
  type = real | kind = r8
  dimensions = (number_of_water_tracer_sets, number_of_water_types)
  intent = in
[ wtrc_qmin ]
  standard_name = minimum_supported_water_tracer_mixing_ratio
  units = kg kg-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ limiter_hdo_hgh ]
  standard_name = upper_hdo_water_tracer_limiter
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ limiter_hdo_low ]
  standard_name = lower_hdo_water_tracer_limiter
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ limiter_18o_hgh ]
  standard_name = upper_h218o_water_tracer_limiter
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ limiter_18o_low ]
  standard_name = lower_h218o_water_tracer_limiter
  units = 1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ limiter_phis_crit ]
  standard_name = water_tracer_limiter_surface_geopotential_threshold
  units = m2 s-2
  type = real | kind = r8
  dimensions = ()
  intent = in
[ radtodeg ]
  standard_name = radians_to_degrees_conversion_factor
  units = degree rad-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ lat ]
  standard_name = latitude
  units = rad
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = in
[ phis ]
  standard_name = surface_geopotential
  units = m2 s-2
  type = real | kind = r8
  dimensions = (horizontal_loop_extent)
  intent = in
[ q ]
  standard_name = constituents
  units = kg kg-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension, number_of_constituents)
  intent = inout
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
