[ccpp-table-properties]
  name = check_energy_chng
  type = scheme

[ccpp-arg-table]
  name = check_energy_chng_timestep_init
  type = scheme
[ ncol ]
  standard_name = horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ ixcldice ]
  standard_name = cloud_ice_constituent_index
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ ixcldliq ]
  standard_name = cloud_liquid_constituent_index
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ ixrain ]
  standard_name = rain_constituent_index
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ ixsnow ]
  standard_name = snow_constituent_index
  units = 1
  type = integer
  dimensions = ()
  intent = in
[ gravit ]
  standard_name = standard_gravitational_acceleration
  units = m s-2
  type = real | kind = r8
  dimensions = ()
  intent = in
[ latvap ]
  standard_name = latent_heat_of_vaporization_of_water
  units = J kg-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ latice ]
  standard_name = latent_heat_of_fusion_of_water
  units = J kg-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ u ]
  standard_name = eastward_wind
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_dimension, vertical_layer_dimension)
  intent = in
[ v ]
  standard_name = northward_wind
  units = m s-1
  type = real | kind = r8
  dimensions = (horizontal_dimension, vertical_layer_dimension)
  intent = in
[ s ]
  standard_name = dry_static_energy
  units = J kg-1
  type = real | kind = r8
  dimensions = (horizontal_dimension, vertical_layer_dimension)
  intent = in
[ q ]
  standard_name = constituents
  units = kg kg-1
  type = real | kind = r8
  dimensions = (horizontal_dimension, vertical_layer_dimension, number_of_constituents)
  intent = in
[ pdel ]
  standard_name = air_pressure_thickness
  units = Pa
  type = real | kind = r8
  dimensions = (horizontal_dimension, vertical_layer_dimension)
  intent = in
[ te_ini ]
  standard_name = vertically_integrated_total_energy_at_start_of_physics
  units = J m-2
  type = real | kind = r8
  dimensions = (horizontal_dimension)
  intent = out
[ tw_ini ]
  standard_name = vertically_integrated_total_water_at_start_of_physics
  units = kg m-2
  type = real | kind = r8
  dimensions = (horizontal_dimension)
  intent = out
[ te_cur ]
  standard_name = vertically_integrated_total_energy
  units = J m-2
  type = real | kind = r8
  dimensions = (horizontal_dimension)
  intent = out
[ tw_cur ]
  standard_name = vertically_integrated_total_water
  units = kg m-2
  type = real | kind = r8
  dimensions = (horizontal_dimension)
  intent = out
[ tend_te_tnd ]
  standard_name = cumulative_total_energy_boundary_flux
  units = J m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_dimension)
  intent = out
[ tend_tw_tnd ]
  standard_name = cumulative_total_water_boundary_flux
  units = kg m-2 s-1
  type = real | kind = r8
  dimensions = (horizontal_dimension)
  intent = out
[ count ]
  standard_name = number_of_energy_or_water_conservation_warnings
  units = count
  type = integer
  dimensions = ()
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out

