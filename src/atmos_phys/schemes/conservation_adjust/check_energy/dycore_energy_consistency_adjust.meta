[ccpp-table-properties]
  name = dycore_energy_consistency_adjust
  type = scheme

[ccpp-arg-table]
  name = dycore_energy_consistency_adjust_run
  type = scheme
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ do_adjust ]
  standard_name = flag_for_dycore_energy_consistency_adjustment
  units = flag
  type = logical
  dimensions = ()
  intent = in
[ scaling_dycore ]
  standard_name = dycore_energy_scaling
  units = 1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ tend_dtdt ]
  standard_name = accumulated_tendency_of_air_temperature
  units = K s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = in
[ tend_dtdt_local ]
  standard_name = tendency_of_air_temperature_due_to_energy_consistency
  units = K s-1
  type = real | kind = r8
  dimensions = (horizontal_loop_extent, vertical_layer_dimension)
  intent = out
[ errmsg ]
  standard_name = ccpp_error_message
  units = none
  type = character | kind = len=512
  dimensions = ()
  intent = out
[ errflg ]
  standard_name = ccpp_error_code
  units = 1
  type = integer
  dimensions = ()
  intent = out
