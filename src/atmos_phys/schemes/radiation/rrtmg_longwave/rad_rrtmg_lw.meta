  units = 1
  type = logical
  dimensions = ()
  intent = in
[ pmidmb ]
  standard_name = rrtmg_layer_pressure
  units = hPa
  type = real | kind = r8
  dimensions = (horizontal_dimension, number_of_rrtmg_levels)
  intent = in
