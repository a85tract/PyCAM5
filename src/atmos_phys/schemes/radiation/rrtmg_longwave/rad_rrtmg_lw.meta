[ccpp-table-properties]
  name = rad_rrtmg_lw
  type = scheme

[ccpp-arg-table]
  name = rad_rrtmg_lw_run
  type = scheme
[ pcols ]
  standard_name = horizontal_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pver ]
  standard_name = vertical_layer_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ pverp ]
  standard_name = vertical_interface_dimension
  units = count
  type = integer
  dimensions = ()
  intent = in
[ lchnk ]
  standard_name = physics_chunk_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ ncol ]
  standard_name = horizontal_loop_extent
  units = count
  type = integer
  dimensions = ()
  intent = in
[ rrtmg_levs ]
  standard_name = number_of_rrtmg_levels
  units = count
  type = integer
  dimensions = ()
  intent = in
[ ntoplw ]
  standard_name = top_longwave_cooling_level_index
  units = index
  type = integer
  dimensions = ()
  intent = in
[ cpair ]
  standard_name = specific_heat_of_dry_air_at_constant_pressure
  units = J kg-1 K-1
  type = real | kind = r8
  dimensions = ()
  intent = in
[ single_column ]
  standard_name = single_column_mode_enabled
  units = 1
  type = logical
  dimensions = ()
  intent = in
[ scm_crm_mode ]
