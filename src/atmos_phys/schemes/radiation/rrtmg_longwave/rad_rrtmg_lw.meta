  standard_name = rrtmg_interface_pressure
  units = hPa
  type = real | kind = r8
  dimensions = (horizontal_dimension, number_of_rrtmg_levels_plus_one)
  intent = in
[ tlay ]
  standard_name = rrtmg_layer_temperature
